# ---- Next.js app (Vercel project env) ----
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase Edge Function secrets (`supabase secrets set NAME=value`) ----
# Names only; never commit values. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically in deployed functions (only needed in supabase/functions/.env for local serve).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_FUNCTIONS_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_ACCESS_TOKEN=
# META_APP_SECRET (above) is also required by webhook-meta
META_VERIFY_TOKEN=
META_API_VERSION=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
UNSUBSCRIBE_BASE_URL=
AI_GATEWAY_API_KEY=
AGENT_MODEL=
CLASSIFIER_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
PREQUAL_BASE_URL=
# Dev only: allow provider='mock' channel numbers. Never set in production.
SALESOS_ALLOW_MOCK_PROVIDER=

# ---- GitHub Actions secrets for .github/workflows/supabase-deploy.yml ----
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD
